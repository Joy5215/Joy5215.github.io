ro"}},{"id":"tech/ROS2/intro","title":"ROS2介绍","description":"关于ROS2的学习记录。","source":"@site/docs/tech/ROS2/intro.md","sourceDirName":"tech/ROS2","slug":"/tech/ROS2/intro","permalink":"/docs/tech/ROS2/intro","draft":false,"unlisted":false,"editUrl":"https://github.com/facebook/docusaurus/tree/main/packages/create-docusaurus/templates/shared/docs/tech/ROS2/intro.md","tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"sidebar_position":1,"title":"ROS2介绍"},"sidebar":"techSiderbar","previous":{"title":"ROS1介绍","permalink":"/docs/tech/ROS1/intro"}}],"drafts":[],"sidebars":{"techSiderbar":[{"type":"doc","id":"tech/intro_tech"},{"type":"category","label":"ROS1","collapsible":true,"collapsed":true,"items":[{"type":"doc","id":"tech/ROS1/intro"}]},{"type":"category","label":"ROS2","collapsible":true,"collapsed":true,"items":[{"type":"doc","id":"tech/ROS2/intro"}]}],"resSiderbar":[{"type":"doc","id":"resources/intro_res"},{"type":"doc","id":"resources/robot"}],"repoSiderbar":[{"type":"doc","id":"repo/intro_repo"}],"bugSiderbar":[{"type":"doc","id":"question/intro_ques"},{"type":"category","label":"vsocde","collapsible":true,"collapsed":true,"items":[{"type":"doc","id":"question/vsocde/ubuntu_cn_wrong"}]}],"aboutSiderbar":[{"type":"doc","id":"about/me"},{"type":"doc","id":"about/support"}]}}]}},"docusaurus-plugin-content-blog":{"default":{"blogSidebarTitle":"Recent posts","blogPosts":[{"id":"vscode 无法输入中文","metadata":{"permalink":"/blog/vscode 无法输入中文","editUrl":"https://github.com/facebook/docusaurus/tree/main/packages/create-docusaurus/templates/shared/blog/2019-05-29-long-blog-post.md","source":"@site/blog/2019-05-29-long-blog-post.md","title":"vscode 无法输入中文","description":"如果是用snap安装的，据说因为阉割版的缘故一定概率出现无法打出中文的现象","date":"2019-05-29T00:00:00.000Z","tags":[{"inline":true,"label":"ubuntu","permalink":"/blog/tags/ubuntu"},{"inline":true,"label":"vscode","permalink":"/blog/tags/vscode"}],"readingTime":2.61,"hasTruncateMarker":false,"authors":[],"frontMatter":{"slug":"vscode 无法输入中文","title":"vscode 无法输入中文","tags":["ubuntu","vscode"]},"unlisted":false},"content":">如果是用snap安装的，据说因为阉割版的缘故一定概率出现无法打出中文的现象\n\n解决方法：卸载snap安装的vsode，不要删除配置（否则之前配置完的C/C++什么的都得重新配），重新安装apt版\n\n利用ai做了个脚本，可以安全卸载snap版并将配置迁移到apt版，已经执行```sudo snap remove code ```但是没删配置文件的也可以用。打开apt版的vscode检查过没问题后可自行删除备份的配置文件.\n## 使用方法\n1. 打开终端,复制脚本内容，保存并关闭\n```\ngedit ~/Desktop/vscode_snapToApt.sh\n```\n2. 开执行权限并执行脚本\n```\nsudo chmod +x ~/Desktop/vscode_snapToApt.sh\n~/Desktop/vscode_snapToApt.sh\n```\n## 脚本内容\n```\n#!/bin/bash\nset -e\n\necho \"===== VS Code Snap → APT 迁移脚本（增强版） =====\"\n\nsafe_remove_snap_code() {\n    echo \"尝试安全卸载 Snap VS Code...\"\n\n    pkill -f code || true\n    sudo snap stop code || true\n\n    echo \"解除 Snap 挂载点...\"\n    sudo umount -l \"$HOME/snap/code/current\" 2>/dev/null || true\n    sudo umount -l \"$HOME/snap/code\"/* 2>/dev/null || true\n\n    echo \"清理 Snap 用户目录...\"\n    rm -rf \"$HOME/snap/code/current\"/*\n    rm -rf \"$HOME/snap/code\"\n\n    echo \"执行 snap remove...\"\n    sudo snap remove code || true\n}\n\n\n# ---------- 路径定义 ----------\nSNAP_CODE_DIR=\"$HOME/snap/code/current\"\nSNAP_CONFIG_DIR=\"$SNAP_CODE_DIR/.config/Code\"\nSNAP_EXT_DIR=\"$SNAP_CODE_DIR/.vscode\"\n\nAPT_CONFIG_DIR=\"$HOME/.config/Code\"\nAPT_EXT_DIR=\"$HOME/.vscode\"\n\nBACKUP_DIR=\"$HOME/vscode-backup\"\n\nFOUND_CONFIG=false\n\n# ---------- Step 1：检测 Snap 风格配置 ----------\nif [ -d \"$SNAP_CONFIG_DIR\" ]; then\n    FOUND_CONFIG=true\nfi\n\nif [ -d \"$SNAP_EXT_DIR\" ]; then\n    FOUND_CONFIG=true\nfi\n\nif [ \"$FOUND_CONFIG\" = false ]; then\n    echo \"未检测到 Snap 风格 VS Code 配置，脚本结束\"\n    exit 0\nfi\n\necho \"检测到 Snap 风格 VS Code 配置\"\n\n# ---------- Step 2：备份配置 ----------\necho \"备份 Snap 配置...\"\nmkdir -p \"$BACKUP_DIR\"\n\nif [ -d \"$SNAP_CONFIG_DIR\" ]; then\n    cp -r \"$SNAP_CONFIG_DIR\" \"$BACKUP_DIR/Code\"\nfi\n\nif [ -d \"$SNAP_EXT_DIR\" ]; then\n    cp -r \"$SNAP_EXT_DIR\" \"$BACKUP_DIR/.vscode\"\nfi\n\n# ---------- Step 3：卸载 Snap 版 VS Code（如存在） ----------\nif snap list | grep -q '^code '; then\n    safe_remove_snap_code\nelse\n    echo \"未检测到已安装的 Snap VS Code，继续迁移配置\"\nfi\n\n\n# ---------- Step 4：安装 APT 版 VS Code ----------\nif ! command -v code &> /dev/null || [[ \"$(which code 2>/dev/null)\" != \"/usr/bin/code\" ]]; then\n    echo \"安装 APT 版 VS Code...\"\n\n    sudo apt update\n    sudo apt install -y wget gpg apt-transport-https\n\n    wget -qO- https://packages.microsoft.com/keys/microsoft.asc \\\n        | gpg --dearmor \\\n        | sudo tee /usr/share/keyrings/microsoft.gpg > /dev/null\n\n    echo \"deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] \\\nhttps://packages.microsoft.com/repos/code stable main\" \\\n        | sudo tee /etc/apt/sources.list.d/vscode.list > /dev/null\n\n    sudo apt update\n    sudo apt install -y code\nelse\n    echo \"APT 版 VS Code 已安装，跳过\"\nfi\n\n# ---------- Step 5：恢复配置 ----------\necho \"恢复配置到 APT 路径...\"\n\nmkdir -p \"$APT_CONFIG_DIR\" \"$APT_EXT_DIR\"\n\nif [ -d \"$BACKUP_DIR/Code\" ]; then\n    cp -r \"$BACKUP_DIR/Code\" \"$HOME/.config/\"\nfi\n\nif [ -d \"$BACKUP_DIR/.vscode\" ]; then\n    cp -r \"$BACKUP_DIR/.vscode\" \"$HOME/\"\nfi\n\n# ---------- Step 6：验证 ----------\necho \"验证 code 命令来源：\"\nwhich code || echo \"code 尚未加入 PATH（重开终端即可）\"\n\necho \"===== 迁移完成 =====\"\necho \"✔ Snap 风格配置已迁移\"\necho \"✔ APT 版 VS Code 已就绪\"\necho \"✔ 配置备份位于：$BACKUP_DIR\"\n```"}],"blogListPaginated":[{"items":["vscode 无法输入中文"],"metadata":{"permalink":"/blog","page":1,"postsPerPage":10,"totalPages":1,"totalCount":1,"blogDescription":"Blog","blogTitle":"Blog"}}],"blogTags":{"/blog/tags/ubuntu":{"inline":true,"label":"ubuntu","permalink":"/blog/tags/ubuntu","items":["vscode 无法输入中文"],"pages":[{"items":["vscode 无法输入中文"],"metadata":{"permalink":"/blog/tags/ubuntu","page":1,"postsPerPage":10,"totalPages":1,"totalCount":1,"blogDescription":"Blog","blogTitle":"Blog"}}],"unlisted":false},"/blog/tags/vscode":{"inline":true,"label":"vscode","permalink":"/blog/tags/vscode","items":["vscode 无法输入中文"],"pages":[{"items":["vscode 无法输入中文"],"metadata":{"permalink":"/blog/tags/vscode","page":1,"postsPerPage":10,"totalPages":1,"totalCount":1,"blogDescription":"Blog","blogTitle":"Blog"}}],"unlisted":false}},"blogTagsListPath":"/blog/tags"}},"docusaurus-plugin-content-pages":{"default":[{"type":"jsx","permalink":"/","source":"@site/src/pages/index.js"},{"type":"mdx","permalink":"/markdown-page","source":"@site/src/pages/markdown-page.md","title":"Markdown page example","description":"You don't need React to write simple standalone pages.","frontMatter":{"title":"Markdown page example"},"unlisted":false}]},"docusaurus-plugin-debug":{},"docusaurus-plugin-svgr":{},"docusaurus-theme-classic":{},"@easyops-cn/docusaurus-search-local":{},"docusaurus-bootstrap-plugin":{},"docusaurus-mdx-fallback-plugin":{}}}